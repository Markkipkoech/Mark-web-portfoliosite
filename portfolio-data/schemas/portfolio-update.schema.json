{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markkipkoech.github.io/Mark-web-portfoliosite/portfolio-data/schemas/portfolio-update.schema.json",
  "title": "Portfolio Project Update",
  "description": "A project update submitted for central portfolio review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "update_id",
    "date",
    "category",
    "title",
    "summary",
    "highlights",
    "technologies",
    "evidence",
    "destination"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "enum": [
        "companyhub",
        "backend-engineering-learning-journey"
      ]
    },
    "update_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "feature",
        "integration",
        "engineering",
        "milestone",
        "learning"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "technologies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 500
      },
      "uniqueItems": true
    },
    "destination": {
      "type": "string",
      "enum": [
        "projects",
        "engineering",
        "learning-journal"
      ]
    }
  }
}
